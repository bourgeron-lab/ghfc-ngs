#!/usr/bin/env python3

"""Copy the cohort's first MELT calls to where the melt step looks for them.

The cohort's first mobile element analysis, run outside the pipeline with MELT v2.2.2
Single, wrote each sample's calls as

    samples/{S1}/{S2}/<ID>/meis/ALU.final_comp.vcf
                                LINE1.final_comp.vcf
                                SVA.final_comp.vcf

The melt step names them after its label, under mei/melt/, and does not see these:

    samples/{S1}/{S2}/<ID>/mei/melt/<ID>.<label>.{ALU,LINE1,SVA}.vcf

This copies them there, so the step reuses them instead of calling every sample again
(about five hours each). meis/ is left as it is, for the scripts that still read it.

A sample is copied only when its three VCFs are non-empty, were written by MELT 2.2.2
(##source=MELTv2.2.2) and name the sample <ID>, and when none of the labelled files
exists yet. Nothing is ever overwritten or deleted. Without --apply it only reports.

    melt_import_existing --data /pasteur/helix/projects/ghfc_wgs/WGS/GHFC-GRCh38 --label melt222
    melt_import_existing ... --apply

Every sample with a meis/ directory is listed with its outcome in --report (a TSV), for
the record.
"""

import argparse
import os
import shutil
import sys
from pathlib import Path

LABEL_CHARS = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")
CLASSES = ("ALU", "LINE1", "SVA")
SOURCE = "##source=MELTv2.2.2"


def vcf_header(path):
    """(whether MELT 2.2.2 wrote it, sample name) of a single-sample VCF."""
    source, sample = False, None
    with open(path) as fh:
        for line in fh:
            if line.startswith("##"):
                source = source or line.rstrip("\n") == SOURCE
                continue
            if line.startswith("#CHROM"):
                f = line.rstrip("\n").split("\t")
                sample = f[9] if len(f) == 10 else None
            break
    return source, sample


def meis_dirs(samples_root):
    """Every samples/{S1}/{S2}/<ID>/meis, by walking the three shard levels."""
    for d1 in sorted(os.scandir(samples_root), key=lambda e: e.name):
        if not d1.is_dir():
            continue
        for d2 in sorted(os.scandir(d1.path), key=lambda e: e.name):
            if not d2.is_dir():
                continue
            for s in sorted(os.scandir(d2.path), key=lambda e: e.name):
                d = Path(s.path) / "meis"
                if d.is_dir():
                    yield s.name, d


def plan(barcode, d, label):
    """(outcome, detail, [(source, target)])."""
    target_dir = d.parent / "mei" / "melt"
    copies = [(d / f"{cls}.final_comp.vcf", target_dir / f"{barcode}.{label}.{cls}.vcf") for cls in CLASSES]
    if all(t.exists() for _s, t in copies):
        return "already_imported", "", []
    for src, _t in copies:
        if not src.exists() or src.stat().st_size == 0:
            return "incomplete", f"{src.name} missing or empty", []
    for src, _t in copies:
        source, sample = vcf_header(src)
        if not source:
            return "refused", f"{src.name} has no {SOURCE} line", []
        if sample != barcode:
            return "refused", f"{src.name} names its sample {sample!r}", []
    clash = [t.name for _s, t in copies if t.exists()]
    if clash:
        return "refused", f"already exists: {', '.join(clash)}", []
    return "copy", f"{len(copies)} files", copies


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--data", required=True, help="the project directory holding samples/")
    ap.add_argument("--label", required=True, help="the melt_label to give the calls")
    ap.add_argument("--ids", help="only these barcodes, one per line")
    ap.add_argument("--report", default="melt_import_existing.tsv")
    ap.add_argument("--apply", action="store_true", help="copy; without it, only report")
    a = ap.parse_args()

    if not a.label or set(a.label) - LABEL_CHARS:
        sys.exit("ERROR: the label may only hold letters, digits, '.', '_' and '-'")
    samples_root = Path(a.data) / "samples"
    if not samples_root.is_dir():
        sys.exit(f"ERROR: {samples_root} is not a directory")
    only = None
    if a.ids:
        only = {l.split()[0] for l in open(a.ids) if l.strip() and not l.startswith("#")}

    counts = {}
    failed = 0
    with open(a.report, "w") as rep:
        rep.write("barcode\toutcome\tdetail\n")
        for barcode, d in meis_dirs(samples_root):
            if only is not None and barcode not in only:
                continue
            outcome, detail, copies = plan(barcode, d, a.label)
            if outcome == "copy" and a.apply:
                done = []
                try:
                    copies[0][1].parent.mkdir(parents=True, exist_ok=True)
                    for src, dst in copies:
                        # Copied under a temporary name and renamed once complete, so an
                        # interrupted copy never leaves a truncated VCF the step would take
                        # for a call
                        if dst.exists():
                            raise FileExistsError(dst)
                        tmp = dst.with_name(dst.name + ".importing")
                        shutil.copyfile(str(src), str(tmp))
                        os.rename(str(tmp), str(dst))
                        done.append(dst.name)
                    outcome = "copied"
                except OSError as e:
                    outcome, failed = "failed", failed + 1
                    detail = f"{e} after copying {', '.join(done) or 'nothing'}"
            counts[outcome] = counts.get(outcome, 0) + 1
            rep.write(f"{barcode}\t{outcome}\t{detail}\n")
            if outcome in ("refused", "incomplete", "failed"):
                print(f"{barcode}: {outcome}: {detail}", file=sys.stderr)

    verb = "" if a.apply else " (dry run: nothing copied; add --apply)"
    print(f"label {a.label}{verb}")
    for outcome in ("copy", "copied", "already_imported", "incomplete", "refused", "failed"):
        if counts.get(outcome):
            print(f"  {outcome:17} {counts[outcome]}")
    print(f"Per-sample outcomes: {a.report}")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
