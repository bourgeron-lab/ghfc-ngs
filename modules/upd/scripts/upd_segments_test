#!/usr/bin/env bash

# Self-contained check of upd_segments, on simulated families. Needs only python3.
#
# Haplotypes are drawn site by site from a frequency, children inherit one haplotype of each
# parent with a crossover per chromosome, and genotypes get a 0.1% error. The family's first
# daughter, C1, carries a maternal isodisomy of chr15, a paternal heterodisomy of chr22 and a
# 3 Mb deletion of her father's chr3; her brother C2 is autozygous over 20 Mb of chr5, his
# parents sharing a haplotype there; C3 has a segmental maternal isodisomy of chr11, away from
# 11p15.5. C1 and C2 also share an artefact on chr8: their genotypes copy their mother's over
# 5 Mb. Asserts that:
#   - the trio finds C1's two UPDs, sets her deletion aside by its depth, and finds nothing in C2 but the
#     chr8 artefact, whose Mendelian errors both siblings carry and so are left out; C3's chr11
#     carries no imprinting;
#   - MZ twins with the same UPD keep it high;
#   - with related parents, a child whose genotypes are her mother's where the parents share a
#     haplotype, and a cluster of parental genotyping errors there, has no heterodisomy, whether
#     her siblings carry the errors (left out) or she has none (the parents hardly informative
#     there); a sister's real heterodisomy of the chromosome, half over that haplotype, stays high;
#   - a segment never spans a region the mask left without sites, and an event joins across it;
#   - the support fraction gates trio and present-parent states, not missing-parent ones;
#   - each duo, masked from the quad, finds C1's UPDs with the right parent, and holds C2's
#     autozygous block to low confidence;
#   - a DUMMY_ father counts as missing, and a father who is not the father is excluded;
#   - chrX is read for the daughter only, with no false call from the hemizygous father;
#   - solo members get the roh step's whole-chromosome and terminal ROH, and nothing when the
#     rest of the genome is not outbred or the parents are related; one long interstitial ROH
#     on the roh step's upd_candidate_chrom is one low interstitial event, not a whole chromosome;
#     two separate long ROH on one chromosome are one medium event (a mixed UPD's pattern); a
#     ROH at half the depth is a deletion, set aside; an interstitial ROH on chr15 is medium and
#     carries 15q11-q13 even where it does not reach it; ROH lengths are of covered genome, so
#     two ROH flanking a masked gap are not an interstitial one; a ROH full of hets is low; an
#     interstitial ROH of 12 Mb is an event on an imprinted chromosome only;
#   - a duo writes no UPD of its present parent below the solo extents, deletions apart;
#   - a position held twice (a split multiallelic site) is dropped, and with the roh panel as a
#     mask, so is a site outside its covered segments;
#   - the cohort marks events found in three other families as recurrent, and refuses a cohort
#     whose family tables are missing;
#   - the windows table has the columns genetics-viz reads, and per 500 kb window the signature
#     of each event: a maternal isodisomy with no het, no maternal- or paternal-specific allele
#     and many opposite homozygotes with the father; a maternal heterodisomy with no
#     paternal-specific allele; the father's deletion the same as an isodisomy, at half the
#     depth; a duo with the mother filling only her columns, solo mode none; chrX for the members
#     with two X, outside the PARs, the father hemizygous.
#
#   modules/upd/scripts/upd_segments_test
#   UPD_TEST_SEED=3 modules/upd/scripts/upd_segments_test     # other families (seed 11 by default)

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT
cd "${work}"

python3 -B - "${here}/upd_segments" <<'EOF'
import gzip
import os
import random
import subprocess
import sys
from importlib.machinery import SourceFileLoader

script = sys.argv[1]
upd = SourceFileLoader("upd_segments", script).load_module()

random.seed(int(os.environ.get("UPD_TEST_SEED", "11")))
CHROMS = [str(i) for i in range(1, 23)] + ["X"]
N_SITES = 6000
STEP = 5000
X_START = 3000000          # past PAR1


def check(cond, msg):
    if not cond:
        print("FAIL  " + msg)
        sys.exit(1)


def positions(c):
    return [(X_START if c == "X" else 100000) + i * STEP for i in range(N_SITES)]


def draw_af():
    return random.uniform(0.01, 0.5) if random.random() < 0.6 else random.uniform(0.0005, 0.01)


AF = {c: [draw_af() for _ in range(N_SITES)] for c in CHROMS}


def haplotype(c):
    return [int(random.random() < p) for p in AF[c]]


def founder(male=False):
    return {c: [haplotype(c)] if (c == "X" and male) else [haplotype(c), haplotype(c)] for c in CHROMS}


def transmitted(parent, c, fixed=None):
    """One allele per site from a parent: its haplotypes with one crossover, or a fixed one."""
    haps = parent[c]
    if len(haps) == 1:
        return list(haps[0])
    if fixed is not None:
        return list(haps[fixed])
    a, xo = random.randint(0, 1), random.randint(0, N_SITES - 1)
    return [haps[a][j] if j < xo else haps[1 - a][j] for j in range(N_SITES)]


def child(father, mother, male=False, special=None):
    """{chrom: (allele list a, allele list b or None for hemizygous, depth factor list)}"""
    special = special or {}
    out = {}
    for c in CHROMS:
        depth = [1.0] * N_SITES
        if c == "X" and male:
            out[c] = (transmitted(mother, c), None, depth)
            continue
        kind = special.get(c)
        if kind == "iso_mat":
            m = transmitted(mother, c)
            out[c] = (m, list(m), depth)
        elif kind == "het_pat":
            out[c] = (list(father[c][0]), list(father[c][1]), depth)
        elif isinstance(kind, tuple) and kind[0] == "del_pat":
            f, m = transmitted(father, c), transmitted(mother, c)
            for j in range(kind[1], kind[2]):
                f[j] = None
                depth[j] = 0.5
            out[c] = (f, m, depth)
        elif isinstance(kind, tuple) and kind[0] == "haps":
            out[c] = (transmitted(father, c, kind[1]), transmitted(mother, c, kind[2]), depth)
        elif isinstance(kind, tuple) and kind[0] in ("iso_mat_seg", "het_mat_seg"):
            f, m = transmitted(father, c), transmitted(mother, c)
            for j in range(kind[1], kind[2]):
                if kind[0] == "iso_mat_seg":
                    f[j] = m[j]
                else:
                    f[j], m[j] = mother[c][0][j], mother[c][1][j]
            out[c] = (f, m, depth)
        else:
            out[c] = (transmitted(father, c), transmitted(mother, c), depth)
    return out


def genotypes_of(person, c):
    """(dosage, depth factor) per site of a founder or child."""
    if isinstance(person[c], tuple):
        a, b, depth = person[c]
        out = []
        for j in range(N_SITES):
            if b is None or a[j] is None:     # hemizygous: one allele, called homozygous
                allele = b[j] if a[j] is None else a[j]
                out.append((2 * allele, depth[j]))
            else:
                out.append((a[j] + b[j], depth[j]))
        return out
    haps = person[c]
    if len(haps) == 1:
        return [(2 * haps[0][j], 1.0) for j in range(N_SITES)]
    return [(haps[0][j] + haps[1][j], 1.0) for j in range(N_SITES)]


GT = {0: "0/0", 1: "0/1", 2: "1/1"}


def stream(people, error=0.001, calls_at=None):
    """bcftools query lines of the given (name, person) list, at sites where one of them carries the ALT.
    calls_at: (chrom, site) -> {name: dosage}, calls that are not the person's genotype (artefacts)."""
    lines = []
    calls_at = calls_at or {}
    for c in CHROMS:
        cols = [genotypes_of(p, c) for _, p in people]
        for j, pos in enumerate(positions(c)):
            calls = []
            forced = calls_at.get((c, j), {})
            for (name, _), col in zip(people, cols):
                d, factor = col[j]
                if name in forced:
                    d = forced[name]
                elif random.random() < error:
                    d = random.choice([x for x in range(3) if x != d])
                calls.append((d, max(10, int(random.randint(26, 34) * factor))))
            if all(d == 0 for d, _ in calls):
                continue
            af = AF[c][j]
            fields = ["chr" + c, str(pos), "." if af < 0.001 else f"{af:.4f}"]
            for d, dp in calls:
                fields += [GT[d], "50", str(dp)]
            lines.append("\t".join(fields))
    return "\n".join(lines) + "\n"


def snapshot(path, fid, rows):
    with open(path, "w") as fh:
        fh.write("#inputs v1\n#step\tupd\n")
        for sample, father, mother, sex, sequenced in rows:
            fh.write("\t".join([fid, sample, father, mother, sex, "yes" if sequenced else "no", "-"]) + "\n")


def run(prefix, fid, rows, people, roh=None, expect_fail=False, extra=(), calls_at=None):
    snapshot(f"{prefix}.inputs.tsv", fid, rows)
    cmd = [sys.executable, script, "family", "--snapshot", f"{prefix}.inputs.tsv",
           "--samples", ",".join(n for n, _ in people), "--out-prefix", prefix] + list(extra)
    if roh:
        cmd += ["--roh", roh[0], "--froh", roh[1]]
    r = subprocess.run(cmd, input=stream(people, calls_at=calls_at), capture_output=True, text=True)
    if expect_fail:
        return r
    check(r.returncode == 0, f"{prefix}: exit {r.returncode}\n{r.stderr}")
    tables = {}
    for kind in ("segments", "events", "members", "windows"):
        header, tables[kind] = upd.read_tsv(f"{prefix}.{kind}.tsv")
    check(header == WINDOW_CONTRACT, f"{prefix}: windows columns {header}")
    return tables


# The columns genetics-viz reads by name
WINDOW_CONTRACT = ["family_id", "sample", "mode", "chrom", "start", "end", "n_sites", "n_het", "n_hom_alt", "n_mat",
                   "n_pat", "n_lacks_father", "n_lacks_mother", "depth_ratio"]
PARENT_COLUMNS = ("n_mat", "n_pat", "n_lacks_father", "n_lacks_mother")


def windows(tables, sample, chrom=None, sites=None):
    """A member's windows, on a chromosome, lying within the span of its sites a to b - 1."""
    lo, hi = (positions(chrom)[sites[0]], positions(chrom)[sites[1] - 1]) if sites else (None, None)
    return [w for w in tables["windows"] if w["sample"] == sample and (chrom is None or w["chrom"] == chrom)
            and (lo is None or lo <= int(w["start"]) and int(w["end"]) <= hi)]


def total(rows, column):
    return sum(int(w[column]) for w in rows)


def rate(rows, column):
    """A count over the windows' sites."""
    return total(rows, column) / total(rows, "n_sites")


def het_fraction(rows):
    return total(rows, "n_het") / (total(rows, "n_het") + total(rows, "n_hom_alt"))


def events_of(tables, sample):
    return [e for e in tables["events"] if e["sample"] == sample]


def member(tables, sample):
    return [m for m in tables["members"] if m["sample"] == sample][0]


def one(events, chrom, what):
    found = [e for e in events if e["chrom"] == chrom]
    check(len(found) == 1, f"{what}: {len(found)} events on chr{chrom}, not one: {found}")
    return found[0]


F, M = founder(male=True), founder()
# The parents share haplotype 0 over chr5 sites 1000-4999 (20 Mb, interstitial)
for j in range(1000, 5000):
    M["5"][0][j] = F["5"][0][j]
C1 = child(F, M, special={"15": "iso_mat", "22": "het_pat", "3": ("del_pat", 1500, 2100), "5": ("haps", 1, 1),
                          "8": ("het_mat_seg", 2000, 3000)})
C2 = child(F, M, male=True, special={"5": ("haps", 0, 0), "8": ("het_mat_seg", 2000, 3000)})
C3 = child(F, M, special={"11": ("iso_mat_seg", 2000, 4000)})
quad = [("F", F), ("M", M), ("C1", C1), ("C2", C2), ("C3", C3)]
rows = [("F", "0", "0", "1", True), ("M", "0", "0", "2", True), ("C1", "F", "M", "2", True),
        ("C2", "F", "M", "1", True), ("C3", "F", "M", "2", True)]

# --- trio --------------------------------------------------------------------------------------
t = run("trio", "FAM", rows, quad)
ev = events_of(t, "C1")
e = one(ev, "15", "trio C1")
check((e["origin"], e["composition"], e["extent"], e["confidence"], e["interpretation"]) ==
      ("maternal", "iso", "whole_chromosome", "high", "UPD"), f"trio C1 chr15: {e}")
check(e["imprinting"] == "Prader-Willi (15q11-q13)", f"trio C1 chr15 imprinting: {e['imprinting']}")
e = one(ev, "22", "trio C1")
check((e["origin"], e["composition"], e["extent"], e["confidence"]) ==
      ("paternal", "het", "whole_chromosome", "high"), f"trio C1 chr22: {e}")
check(not [x for x in ev if x["chrom"] == "3"], f"trio C1: the chr3 deletion is written: {ev}")
others = [x for x in ev if x["chrom"] not in ("15", "22", "3", "8")]
check(not others, f"trio C1 has other events: {others}")
shared = [x for x in ev + events_of(t, "C2") if x["chrom"] == "8"]
check(not shared, f"trio chr8 artefact of C1 and C2, Mendelian errors they share, is an event: {shared}")
check(int(member(t, "C1")["n_sibling_errors"]) > 0 and int(member(t, "C2")["n_sibling_errors"]) > 0,
      f"trio: no site left out for a sibling's error: {t['members']}")
check(all(x["chrom"] == "8" for x in events_of(t, "C2")), f"trio C2 (autozygous chr5) has events: {events_of(t, 'C2')}")
e = one(events_of(t, "C3"), "11", "trio C3")
check((e["origin"], e["composition"], e["extent"], e["confidence"], e["imprinting"]) ==
      ("maternal", "iso", "segmental", "high", "."), f"trio C3 chr11: {e}")
check(member(t, "C1")["mode"] == "trio" and member(t, "C1")["chrx"] == "yes", f"trio C1: {member(t, 'C1')}")
check(member(t, "C2")["chrx"] == "no", f"trio C2 chrX: {member(t, 'C2')}")
check(member(t, "F")["mode"] == "solo" and member(t, "F")["status"] == "no_roh_tables", f"trio F: {member(t, 'F')}")
check(float(member(t, "C1")["error_rate"]) < 0.01, f"trio C1 error rate {member(t, 'C1')['error_rate']}")
seg = [s for s in t["segments"] if s["sample"] == "C1" and s["chrom"] == "15"]
check(all(int(s["n_strong"]) >= 20 and float(s["lod"]) > 20 for s in seg), f"trio C1 chr15 segments: {seg}")
print("ok    trio: maternal isodisomy 15, paternal heterodisomy 22, the deletion set aside; no call in an autozygous block;"
      " an artefact two siblings share is no event; a segmental UPD away from 11p15.5 has no imprinting")

# The windows, against the chromosomes of C1 that are inherited normally
W = upd.WINDOW_BP
check(all(int(w["start"]) % W == 1 and int(w["end"]) == int(w["start"]) + W - 1 and int(w["n_sites"]) > 0
          for w in t["windows"]), "trio windows: not 500 kb bins from 1, or a window with no site")
for sample in ("C1", "C2", "C3", "F", "M"):
    keys = [(CHROMS.index(w["chrom"]), int(w["start"])) for w in windows(t, sample)]
    check(keys == sorted(set(keys)), f"trio windows of {sample}: not in chromosome and position order")
normal = [w for w in windows(t, "C1") if w["chrom"] in ("1", "2", "4", "6", "7", "9", "10")]
check(all(w["mode"] == "trio" for w in windows(t, "C1")), "trio windows: C1 not in trio mode")
check(0.8 < total(normal, "n_mat") / total(normal, "n_pat") < 1.25, "trio windows: n_mat and n_pat differ "
      f"on normal chromosomes: {total(normal, 'n_mat')} {total(normal, 'n_pat')}")
check(rate(normal, "n_lacks_father") < 0.005 and rate(normal, "n_lacks_mother") < 0.005,
      f"trio windows: opposite homozygotes on normal chromosomes: {rate(normal, 'n_lacks_father')}")
check(all(0.8 <= float(w["depth_ratio"]) <= 1.25 for w in normal), "trio windows: depth ratio of normal windows")
iso_mat = windows(t, "C1", "15")
check(len(iso_mat) >= 50, f"trio windows: {len(iso_mat)} windows on chr15")
check(rate(iso_mat, "n_het") < 0.01 and rate(iso_mat, "n_mat") < 0.01 and rate(iso_mat, "n_pat") < 0.01,
      f"trio windows: the maternal isodisomy has hets: {total(iso_mat, 'n_het')} of {total(iso_mat, 'n_sites')}")
check(rate(iso_mat, "n_lacks_father") > 0.05 and rate(iso_mat, "n_lacks_father") > 20 * rate(normal, "n_lacks_father")
      and rate(iso_mat, "n_lacks_mother") < 0.01, "trio windows: opposite homozygotes in the maternal isodisomy: "
      f"father {rate(iso_mat, 'n_lacks_father')}, mother {rate(iso_mat, 'n_lacks_mother')}")
het_mat = windows(t, "C1", "8", (2000, 3000))
check(len(het_mat) >= 8 and rate(het_mat, "n_pat") < 0.01 and rate(het_mat, "n_mat") > 0.5 * rate(normal, "n_mat")
      and abs(het_fraction(het_mat) - het_fraction(normal)) < 0.1,
      f"trio windows: the maternal heterodisomy: n_mat {total(het_mat, 'n_mat')}, n_pat {total(het_mat, 'n_pat')}")
het_pat = windows(t, "C1", "22")
check(rate(het_pat, "n_mat") < 0.01 and rate(het_pat, "n_pat") > 0.5 * rate(normal, "n_pat"),
      f"trio windows: the paternal heterodisomy: n_mat {total(het_pat, 'n_mat')}, n_pat {total(het_pat, 'n_pat')}")
deletion = windows(t, "C1", "3", (1500, 2100))
check(deletion and all(float(w["depth_ratio"]) < 0.65 for w in deletion)
      and rate(deletion, "n_het") < 0.1 * rate(normal, "n_het") and rate(deletion, "n_lacks_father") > 0.05, "trio windows: the father's deletion is not an isodisomy at half "
      f"the depth: {deletion}")
check(windows(t, "C1", "X") and windows(t, "C3", "X") and not windows(t, "C2", "X") and not windows(t, "F", "X"),
      "trio windows: chrX not for the members with two X only")
x = windows(t, "C1", "X")
check(total(x, "n_mat") == total(x, "n_het") > 0 and rate(x, "n_lacks_father") < 0.01,
      f"trio windows: chrX of C1, with a hemizygous father: {total(x, 'n_mat')} {total(x, 'n_het')}")
for sample in ("F", "M"):
    rows_solo = windows(t, sample)
    check(rows_solo and all(w["mode"] == "solo" and all(w[c] == "." for c in PARENT_COLUMNS) for w in rows_solo)
          and 0.3 < het_fraction(rows_solo) < 0.9, f"trio windows: {sample}, solo, has parent counts or no het")
check(windows(t, "M", "X"), "trio windows: no chrX for the mother")
print("ok    windows: a maternal isodisomy has no het, no maternal- or paternal-specific allele and many opposite"
      " homozygotes with the father; a maternal heterodisomy no paternal-specific allele; the father's deletion is"
      " an isodisomy at half the depth; chrX for two X only, the father hemizygous; solo members have no parent column")

T1 = child(F, M, special={"15": "iso_mat"})
tw = run("twins", "TWIN", rows[:2] + [("T1", "F", "M", "2", True), ("T2", "F", "M", "2", True)],
         [("F", F), ("M", M), ("T1", T1), ("T2", T1)])
for s, other in (("T1", "T2"), ("T2", "T1")):
    e = one(events_of(tw, s), "15", f"twin {s}")
    check(e["confidence"] == "high" and e["shared_with"] == other and "MZ twin" in e["notes"], f"twin {s}: {e}")
print("ok    MZ twins keep the UPD they share")

# Related parents: P and Q share a haplotype over chr7 sites 1000-3999 (15 Mb), where they have no
# opposite homozygote. K1 got the shared haplotype from P and Q's other one: her genotypes are
# Q's there, normal inheritance that reads as a maternal heterodisomy wherever the parents are
# opposite homozygotes, and there are none. The calls of 20 sites in 100 kb are an artefact of
# the parents' (a deletion, say): P 1/1 and Q 0/0, K1 and K2 0/0, K3 0/1. K3 has a real maternal
# heterodisomy of chr7, half of it where the parents share a haplotype
P, Q = founder(male=True), founder()
for j in range(1000, 4000):
    Q["7"][0][j] = P["7"][0][j]
K1 = child(P, Q, special={"7": ("haps", 0, 1)})
K2 = child(P, Q, special={"7": ("haps", 1, 0)})
K3 = child(P, Q, special={"7": ("het_mat_seg", 0, N_SITES)})
artefact = {("7", j): {"P": 2, "Q": 0, "K1": 0, "K2": 0, "K3": 1} for j in range(2000, 2020)}
rows_cons = [("P", "0", "0", "1", True), ("Q", "0", "0", "2", True), ("K1", "P", "Q", "2", True),
             ("K2", "P", "Q", "2", True), ("K3", "P", "Q", "2", True)]
c = run("related", "REL", rows_cons, [("P", P), ("Q", Q), ("K1", K1), ("K2", K2), ("K3", K3)], calls_at=artefact)
check(not [e for e in events_of(c, "K1") + events_of(c, "K2") if e["chrom"] == "7"],
      f"related parents: an event on chr7 of K1 or K2: {events_of(c, 'K1') + events_of(c, 'K2')}")
e = one(events_of(c, "K3"), "7", "related parents K3")
check((e["origin"], e["composition"], e["extent"], e["confidence"]) == ("maternal", "het", "whole_chromosome", "high"),
      f"related parents: K3's heterodisomy: {e}")
check(int(member(c, "K1")["n_sibling_errors"]) >= 20 and int(member(c, "K3")["n_sibling_errors"]) >= 20,
      f"related parents: sites with a sibling's Mendelian error: {c['members']}")
c = run("related_trio", "REL", rows_cons[:3], [("P", P), ("Q", Q), ("K1", K1)], calls_at=artefact)
check(not [e for e in events_of(c, "K1") if e["chrom"] == "7"],
      f"related parents, one child: an event on chr7: {events_of(c, 'K1')}")
check(member(c, "K1")["n_sibling_errors"] == "0", f"related parents, one child: {member(c, 'K1')}")
print("ok    related parents: a parental artefact where they share a haplotype is no heterodisomy, with siblings"
      " or without; a real heterodisomy half over the shared haplotype stays high")

seg = {"weak": False, "diffuse": False, "lod": 100.0, "length_mb": 5.0, "depth_ratio": 1.0, "n_strong": 50,
       "n_supporting": 100, "state": "het", "support_fraction": 0.5}
check(upd.classify(seg) == ("heterodisomy", "low"), f"support 0.5 in a trio: {upd.classify(seg)}")
check(upd.classify(dict(seg, support_fraction=0.95)) == ("heterodisomy", "high"), "support 0.95 in a trio")
check(upd.classify(dict(seg, diffuse=True)) == ("heterodisomy", "high"), "support 0.5 of a missing parent's het")
check(upd.classify(dict(seg, diffuse=True, support_fraction=0.4))[1] == "low", "support 0.4 of a missing parent's het")
check(upd.classify(dict(seg, diffuse=True, state="iso", support_fraction=0.8))[1] == "low", "iso of a missing parent at 0.8")
check(upd.classify(dict(seg, diffuse=True, state="iso", support_fraction=0.95))[1] == "high", "iso of a missing parent at 0.95")
print("ok    the support fraction gates every state, at 0.5 for a heterodisomy of a duo's missing parent")

# The roh panel as a mask: a site every 100 kb, but on chr22 only up to 3 Mb, and none on chr15
# between 10 and 16 Mb; chrX not held
with gzip.open("mask.tsv.gz", "wt") as fh:
    fh.write("chrom\tpos\tref\talt\n")
    for c in CHROMS[:-1]:
        for pos in positions(c)[::20]:
            if (c != "22" or pos <= 3000000) and (c != "15" or not 10000000 <= pos <= 16000000):
                fh.write(f"{c}\t{pos}\tA\tG\n")
m = run("mask", "FAM", rows, quad, extra=["--mask", "mask.tsv.gz"])
ev = events_of(m, "C1")
e = one(ev, "15", "masked C1")
check(e["confidence"] == "high" and e["extent"] == "whole_chromosome", f"masked: chr15 not joined across the gap: {e}")
spanning = [s for s in m["segments"] if s["sample"] == "C1" and s["chrom"] == "15"
            and int(s["start"]) < 10000000 and int(s["end"]) > 16000000]
check(not spanning, f"masked: a segment spans the gap: {spanning}")
check(all(int(e["end"]) <= 3000000 for e in ev if e["chrom"] == "22"), f"masked: chr22 past 3 Mb: {ev}")
check(member(m, "C1")["chrx"] == "yes" and int(member(m, "C1")["n_sites"]) < int(member(t, "C1")["n_sites"]),
      f"masked: sites {member(m, 'C1')}")
print("ok    the roh panel as a mask drops the sites outside its covered segments; no segment spans the gap")

# --- duos --------------------------------------------------------------------------------------
rows_no_f = [("F", "0", "0", "1", False)] + rows[1:]
d = run("duo_mother", "FAM", rows_no_f, [("M", M), ("C1", C1), ("C2", C2)])
ev = events_of(d, "C1")
e = one(ev, "22", "duo mother C1")
check((e["origin"], e["composition"], e["confidence"]) == ("paternal", "het", "high"), f"duo mother C1 chr22: {e}")
e = one(ev, "15", "duo mother C1")
check((e["origin"], e["composition"], e["extent"], e["confidence"]) == ("maternal", "iso", "whole_chromosome", "high"),
      f"duo mother C1 chr15: {e}")
check(not [x for x in ev if x["chrom"] == "3"], f"duo mother C1: the chr3 deletion is written: {ev}")
check(member(d, "C1")["mode"] == "duo" and member(d, "C1")["father_used"] == ".", f"duo mother C1: {member(d, 'C1')}")
small = [x for x in d["events"] if x["origin"] == "maternal" and x["interpretation"] != "deletion"
         and x["extent"] != "whole_chromosome" and float(x["length_mb"]) < 15 and
         not (x["terminal"] == "yes" and float(x["length_mb"]) >= 5)]
check(not small, f"duo mother: UPDs of the present parent below the solo extents: {small}")
ev2 = events_of(d, "C2")
check(all(x["confidence"] == "low" for x in ev2), f"duo mother C2 autozygous block not held low: {ev2}")
print("ok    duo with the mother: paternal heterodisomy, maternal isodisomy, the deletion set aside; autozygosity held low")
rows_duo = windows(d, "C1")
check(rows_duo and all(w["mode"] == "duo" and w["n_mat"] == w["n_lacks_father"] == "." and w["n_pat"] != "."
                       and w["n_lacks_mother"] != "." for w in rows_duo), "duo windows: the father's columns are filled")
normal = [w for w in rows_duo if w["chrom"] in ("1", "2", "4", "6", "7", "9", "10")]
iso_mat, het_pat = windows(d, "C1", "15"), windows(d, "C1", "22")
check(rate(iso_mat, "n_pat") < 0.01 and rate(iso_mat, "n_lacks_mother") < 0.01,
      f"duo windows: the maternal isodisomy against the mother: {rate(iso_mat, 'n_lacks_mother')}")
check(rate(het_pat, "n_lacks_mother") > 0.02 and rate(het_pat, "n_lacks_mother") > 20 * rate(normal, "n_lacks_mother"),
      f"duo windows: the paternal heterodisomy lacks no maternal allele: {rate(het_pat, 'n_lacks_mother')}")
print("ok    windows of a duo with the mother: her columns only, and no allele of hers in the paternal heterodisomy")

rows_no_m = [rows[0], ("M", "0", "0", "2", False)] + rows[2:]
d = run("duo_father", "FAM", rows_no_m, [("F", F), ("C1", C1)])
ev = events_of(d, "C1")
e = one(ev, "15", "duo father C1")
check((e["origin"], e["composition"], e["confidence"]) == ("maternal", "iso", "high"), f"duo father C1 chr15: {e}")
e = one(ev, "22", "duo father C1")
check((e["origin"], e["composition"], e["confidence"]) == ("paternal", "het", "high"), f"duo father C1 chr22: {e}")
check(not [x for x in ev if x["chrom"] == "3"], f"duo father C1: the chr3 deletion is written: {ev}")
print("ok    duo with the father: the same events, from the other side")

# --- dummy father, non-father --------------------------------------------------------------------
rows_dummy = [("DUMMY_C1_F", "0", "0", "1", False), rows[1], ("C1", "DUMMY_C1_F", "M", "2", True)]
d = run("dummy", "FAM", rows_dummy, [("M", M), ("C1", C1)])
check(member(d, "C1")["mode"] == "duo" and not [m for m in d["members"] if m["sample"].startswith("DUMMY_")],
      f"dummy: {d['members']}")
print("ok    a DUMMY_ father is missing, and not a member of the tables")

U = founder(male=True)
d = run("nonfather", "FAM", [("U", "0", "0", "1", True), rows[1], ("C1", "U", "M", "2", True)],
        [("U", U), ("M", M), ("C1", C1)])
m = member(d, "C1")
check(m["mode"] == "duo" and m["father_used"] == "." and m["status"].startswith("parentage: father U"),
      f"non-father: {m}")
check(one(events_of(d, "C1"), "22", "non-father C1")["confidence"] == "high", "non-father: chr22 lost")
print("ok    a father who is not the father is excluded, and the child redone as a duo")

# --- solo, from the roh tables -------------------------------------------------------------------
def solo_person(roh):
    """A founder whose genotypes are homozygous over its ROH (chrom, first site, last site)."""
    p = founder()
    for c, a, b in roh:
        for j in range(a, b):
            p[c][1][j] = p[c][0][j]
    return p


S1 = solo_person([("15", 0, N_SITES)])
S2 = solo_person([("2", 0, 1200), ("7", 2000, 3000)])
S3 = solo_person([("4", 0, 4000), ("9", 500, 4500), ("12", 1000, 5000)])
S4 = solo_person([("15", 0, N_SITES)])
S5 = solo_person([("5", 1000, 5000), ("5", 5400, 5500)])
S6 = solo_person([("13", 500, 1700), ("13", 3500, 4700)])
S7 = founder()
S7["14"] = ([None if 1000 <= j < 1900 else a for j, a in enumerate(S7["14"][0])], list(S7["14"][1]),
            [0.5 if 1000 <= j < 1900 else 1.0 for j in range(N_SITES)])
S8 = solo_person([("15", 1000, 4600)])
S9 = solo_person([("10", 1000, 2000), ("10", 4000, 5000)])
S10 = solo_person([("17", 0, 1200)])
for j in range(0, 1200):
    if random.random() < 0.15:
        S10["17"][1][j] = 1 - S10["17"][0][j]
S11 = solo_person([("14", 1000, 3400)])
S12 = solo_person([("9", 1000, 3400)])


def roh_rows(sample, roh):
    out = []
    for c, a, b in roh:
        s, e = positions(c)[a], positions(c)[b - 1]
        out.append(f"{sample}\tchr{c}\t{s}\t{e}\t{(e - s) / 1e6:.3f}\t1\t{b - a}\t40\tlong\tEUR\t0\t0")
    return out


rohs = {"S1": [("15", 0, 2950), ("15", 3050, N_SITES)], "S2": [("2", 0, 1200), ("7", 2000, 3000)],
        "S3": [("4", 0, 4000), ("9", 500, 4500), ("12", 1000, 5000)], "S4": [("15", 0, N_SITES)],
        "S5": [("5", 1000, 5000), ("5", 5400, 5500)], "S6": [("13", 500, 1700), ("13", 3500, 4700)],
        "S7": [("14", 1000, 1900)], "S8": [("15", 1000, 4600)], "S9": [("10", 1000, 2000), ("10", 4000, 5000)],
        "S10": [("17", 0, 1200)], "S11": [("14", 1000, 3400)], "S12": [("9", 1000, 3400)]}
with open("solo.roh.tsv", "w") as fh:
    fh.write("IID\tchrom\tstart\tend\tlength_mb\tlength_cm\tn_sites\tquality\troh_class\thotspot_group\t"
             "hotspot_fraction\thotspot_fraction_pooled\n")
    for s, r in rohs.items():
        for line in roh_rows(s, r):
            fh.write(line + "\n")
with open("solo.froh.tsv", "w") as fh:
    fh.write("IID\tregion\tfroh_1.5mb\tupd_candidate_chrom\tfather\tmother\tparents_kinship\n")
    fh.write("S1\tEUR\t0.04\t15\t.\t.\tNA\nS2\tEUR\t0.01\t.\t.\t.\tNA\nS3\tEUR\t0.2\t.\t.\t.\tNA\n"
             "S4\tEUR\t0.04\t15\tP1\tP2\t0.06\nS5\tEUR\t0.03\t5\t.\t.\tNA\n"
             "S6\tEUR\t0.02\t13\t.\t.\tNA\nS7\tEUR\t0.0\t.\t.\t.\tNA\nS8\tEUR\t0.02\t15\t.\t.\tNA\n"
             "S9\tEUR\t0.0\t.\t.\t.\tNA\nS10\tEUR\t0.0\t.\t.\t.\tNA\nS11\tEUR\t0.0\t.\t.\t.\tNA\n"
             "S12\tEUR\t0.0\t.\t.\t.\tNA\n")
# A mask with no site on chr10 between 10.15 and 20.05 Mb, where S9's two ROH stop and start
with gzip.open("solo_mask.tsv.gz", "wt") as fh:
    fh.write("chrom\tpos\tref\talt\n")
    for c in CHROMS[:-1]:
        for pos in positions(c)[::20]:
            if c != "10" or not 10150000 <= pos <= 20050000:
                fh.write(f"{c}\t{pos}\tA\tG\n")
d = run("solo", "SOLO", [(s, "0", "0", "2", True) for s in ("S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "S11", "S12")],
        [("S1", S1), ("S2", S2), ("S3", S3), ("S4", S4), ("S5", S5), ("S6", S6), ("S7", S7), ("S8", S8),
         ("S9", S9), ("S10", S10), ("S11", S11), ("S12", S12)],
        roh=("solo.roh.tsv", "solo.froh.tsv"), extra=["--mask", "solo_mask.tsv.gz"])
e = one(events_of(d, "S1"), "15", "solo S1")
check((e["origin"], e["extent"], e["confidence"], e["n_segments"]) == ("unknown", "whole_chromosome", "high", "2"),
      f"solo S1: {e}")
check("Prader-Willi if maternal" in e["imprinting"] and "Angelman if paternal" in e["imprinting"], e["imprinting"])
check(float(e["lod"]) > 50, f"solo S1 lod {e['lod']}")
ev = events_of(d, "S2")
check(len(ev) == 1 and ev[0]["chrom"] == "2" and ev[0]["confidence"] == "medium" and ev[0]["terminal"] == "yes",
      f"solo S2 (terminal chr2, short interstitial chr7): {ev}")
check(not events_of(d, "S3"), f"solo S3 (consanguineous) has events: {events_of(d, 'S3')}")
check(member(d, "S4")["status"].startswith("not_isolated"), f"solo S4: {member(d, 'S4')}")
ev = events_of(d, "S5")
check(len(ev) == 1 and (ev[0]["chrom"], ev[0]["extent"], ev[0]["confidence"]) == ("5", "segmental", "low")
      and "interstitial" in ev[0]["notes"] and "upd_candidate_chrom" in ev[0]["notes"],
      f"solo S5 (one interstitial ROH on upd_candidate_chrom): {ev}")
ev = events_of(d, "S6")
check(len(ev) == 1 and (ev[0]["chrom"], ev[0]["confidence"], ev[0]["n_segments"]) == ("13", "medium", "2")
      and "mixed UPD" in ev[0]["notes"], f"solo S6 (two long ROH on chr13): {ev}")
check(not events_of(d, "S7"), f"solo S7 (a ROH at half the depth) has events: {events_of(d, 'S7')}")
ev = events_of(d, "S8")
check(len(ev) == 1 and (ev[0]["chrom"], ev[0]["confidence"]) == ("15", "medium")
      and ev[0]["imprinting"] == "Prader-Willi if maternal or Angelman if paternal (15q11-q13, if the UPD reaches it)",
      f"solo S8 (an interstitial ROH on chr15, short of 15q11-q13): {ev}")
check(not events_of(d, "S9"), f"solo S9 (two ROH flanking a masked gap, 10 Mb covered) has events: {events_of(d, 'S9')}")
ev = events_of(d, "S10")
check(len(ev) == 1 and ev[0]["confidence"] == "low" and "support fraction" in ev[0]["notes"],
      f"solo S10 (a terminal ROH with hets): {ev}")
ev = events_of(d, "S11")
check(len(ev) == 1 and (ev[0]["chrom"], ev[0]["confidence"]) == ("14", "medium") and "Temple if maternal" in ev[0]["imprinting"],
      f"solo S11 (a 12 Mb interstitial ROH on chr14): {ev}")
check(not events_of(d, "S12"), f"solo S12 (a 12 Mb interstitial ROH on chr9) has events: {events_of(d, 'S12')}")
print("ok    solo: whole-chromosome and terminal ROH, none in a consanguineous background or with related parents;"
      " a long interstitial ROH on upd_candidate_chrom stays an interstitial, low; two long ROH on one chromosome"
      " are one medium event; a ROH at half the depth is set aside; an interstitial ROH on chr15 is medium;"
      " lengths are of covered genome; a ROH full of hets is low; 12 Mb interstitial counts on an imprinted chromosome")
rows_solo = windows(d, "S1")
check(rows_solo and all(w["mode"] == "solo" and all(w[c] == "." for c in PARENT_COLUMNS) for w in rows_solo),
      "solo windows: parent columns filled")
roh, rest = windows(d, "S1", "15"), [w for w in rows_solo if w["chrom"] in ("1", "2", "3", "4")]
check(het_fraction(roh) < 0.1 * het_fraction(rest) and het_fraction(rest) > 0.3,
      f"solo windows: het fraction {het_fraction(roh)} in the whole-chromosome ROH, {het_fraction(rest)} elsewhere")
deletion = windows(d, "S7", "14", (1000, 1900))
check(deletion and all(float(w["depth_ratio"]) < 0.65 for w in deletion)
      and het_fraction(deletion) < 0.1 * het_fraction(rest),
      "solo windows: a deletion is not a ROH at half the depth")
print("ok    windows in solo mode: het counts only, none in a ROH, and a deletion at half the depth")

# --- parsing -----------------------------------------------------------------------------------
lines = ["chr1\t100\t0.1\t0/1\t50\t30", "chr1\t200\t0.2\t0/1\t50\t30", "chr1\t200\t0.2\t1/1\t50\t30",
         "chr1\t300\t.\t1/1\t10\t30", "chr1\t400\t0.3\t./.\t50\t30", "chrY\t500\t0.1\t0/1\t50\t30",
         "chr2\t600\t0.5\t1|0\t50\t9"]
chroms = upd.read_sites(iter(line + "\n" for line in lines), 1)
check(list(chroms["1"].pos) == [100, 300, 400], f"positions {list(chroms['1'].pos)}")
check(list(chroms["1"].g[0]) == [1, upd.MISSING, upd.MISSING], f"dosages {list(chroms['1'].g[0])}")
check(chroms["1"].af[1] == 1 and "Y" not in chroms, "af or chrY")
check(list(chroms["2"].g[0]) == [upd.MISSING], "DP 9 counted")
print("ok    a position held twice is dropped; GQ, DP, missing calls and chrY")

# chrX windows site by site: a site in each PAR, a father het (missing: he has one X), a missing
# child call, a child call over its depth cap, then three sites the trio uses
chrom = upd.Chrom("X", 3)
for pos, f, m, c, depth in ((1000000, 0, 1, 1, 30), (155800000, 0, 1, 1, 30), (3000010, 1, 1, 1, 30),
                            (3000020, 0, 1, upd.MISSING, 30), (3000025, 0, 1, 1, 200), (3000030, 2, 1, 1, 30),
                            (3000040, 0, 2, 2, 30), (3500001, 0, 1, 1, 30)):
    chrom.pos.append(pos)
    chrom.af.append(100)
    for i, d in enumerate((f, m, c)):
        chrom.g[i].append(d)
        chrom.dp[i].append(depth if i == 2 else 30)
index, caps = {"F": 0, "M": 1, "C": 2}, [75, 75, 75]
child_x = upd.Member("C", 2, {})
child_x.father, child_x.mother, child_x.mode, child_x.chrx = "F", "M", "trio", "yes"
got = [(w["start"], w["end"], [w[k] for k in WINDOW_CONTRACT[6:13]], w["depth_ratio"])
       for w in upd.window_rows("FX", child_x, {"X": chrom}, index, caps, 30.0)]
check(got == [(3000001, 3500000, [2, 1, 1, 1, 0, 1, 0], 1.0), (3500001, 4000000, [1, 1, 0, 1, 0, 0, 0], 1.0)],
      f"chrX trio windows: {got}")
child_x.father, child_x.mode = None, "duo"
got = [[w[k] for k in WINDOW_CONTRACT[6:13]] for w in upd.window_rows("FX", child_x, {"X": chrom}, index, caps, 30.0)]
check(got == [[3, 2, 1, None, 0, None, 0], [1, 1, 0, None, 0, None, 0]], f"chrX duo windows: {got}")
child_x.mother, child_x.mode = None, "solo"
got = [[w[k] for k in WINDOW_CONTRACT[6:13]] for w in upd.window_rows("FX", child_x, {"X": chrom}, index, caps, 30.0)]
check(got == [[3, 2, 1, None, None, None, None], [1, 1, 0, None, None, None, None]], f"chrX solo windows: {got}")
child_x.chrx = "no"
check(not upd.window_rows("FX", child_x, {"X": chrom}, index, caps, 30.0), "chrX windows of a member with one X")
print("ok    chrX windows: the PARs skipped, a father het missing, a call over the depth cap left out, and nothing for"
      " a member with one X")

# --- cohort ------------------------------------------------------------------------------------
os.makedirs("fam", exist_ok=True)
fids = ["FA", "FB", "FC", "FD", "FE"]
for fid in fids:
    chrom, start, end = ("2", 5000000, 9000000) if fid == "FE" else ("1", 10000000 + fids.index(fid) * 100000,
                                                                       20000000)
    upd.write_tsv(f"fam/{fid}.upd_v1.events.tsv", upd.EVENT_COLUMNS, [
        {"family_id": fid, "sample": f"{fid}_C", "mode": "trio", "event_id": f"{fid}_C:{chrom}:maternal",
         "chrom": chrom, "start": start, "end": end, "length_mb": (end - start) / 1e6, "origin": "maternal",
         "confidence": "high"}])
    upd.write_tsv(f"fam/{fid}.upd_v1.segments.tsv", upd.SEGMENT_COLUMNS, [])
    upd.write_tsv(f"fam/{fid}.upd_v1.members.tsv", upd.MEMBER_COLUMNS,
                  [{"family_id": fid, "sample": f"{fid}_C", "mode": "trio", "status": "analysed"}])
with open("cohort.inputs.tsv", "w") as fh:
    fh.write("#inputs v1\n")
    for fid in fids:
        fh.write(f"{fid}\t{fid}_C\t0\t0\t2\tyes\t-\n")
r = subprocess.run([sys.executable, script, "cohort", "--cohort", "CO", "--snapshot", "cohort.inputs.tsv",
                    "--family-dir", "fam", "--label", "upd_v1", "--out-prefix", "CO.upd_v1"],
                   capture_output=True, text=True)
check(r.returncode == 0, f"cohort: {r.stderr}")
ev = {e["family_id"]: e for e in upd.read_tsv("CO.upd_v1.events.tsv")[1]}
check(all(ev[f]["recurrent"] == "yes" and ev[f]["recurrent_families"] == "3" for f in ("FA", "FB", "FC", "FD")),
      f"recurrent: {ev}")
check(ev["FE"]["recurrent"] == "no", "FE recurrent")
os.remove("fam/FE.upd_v1.members.tsv")
r = subprocess.run([sys.executable, script, "cohort", "--cohort", "CO", "--snapshot", "cohort.inputs.tsv",
                    "--family-dir", "fam", "--label", "upd_v1", "--out-prefix", "CO.upd_v1"],
                   capture_output=True, text=True)
check(r.returncode != 0 and "FE" in r.stderr, f"a missing family table was not refused: {r.stderr}")
print("ok    cohort: events of four families overlapping are recurrent; a missing family is refused")
