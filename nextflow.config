// Nextflow configuration file for GHFC WGS Alignment Pipeline

params {
    // Pipeline steps control
    steps = ['alignment']  
    skip_alignment = false
    skip_deepvariant = false
    
    // Input/Output paths
    data = ""
    scratch = ""
    
    // Reference genomes
    ref = ""
    ref_name = ""
    old_ref_38 = ""
    old_cram_38 = ""
    old_ref_37 = ""
    old_cram_37 = ""
    
    // File patterns
    fastq_pattern = ""
    cram4realignment_pattern = "*.cram"
    
    // Bedgraph parameters
    bin = 1000  // Bin size for bedgraph generation
    
    // Tool paths (can be overridden when using containers)
    bwa_mem2 = "bwa-mem2"
    samblaster = "samblaster"
    sambamba = "sambamba"
    samtools = "samtools"
    bazam = "/path/to/bazam.jar"
    
    // GLnexus configuration
    glnexus_config = "DeepVariant_unfiltered"
    // Optional BED of ranges to joint-call, for exome cohorts: a DeepVariant gVCF covers the
    // whole genome with reference blocks, so without it every off-target call reaches annotation.
    // Must be sorted and merged - GLnexus rejects overlapping ranges. Empty calls the whole genome.
    glnexus_bed = ""

    // Whether a sample's VAF bedgraph is part of its deepvariant_sample outputs. Turn it off for
    // a cohort that arrives as gVCFs only: the bedgraph is built from the CRAM-derived VCF, so it
    // can never exist, and requiring it would send every sample back to alignment.
    vaf_bedgraph = true

    // DeepVariant configuration
    // WARNING: Update DeepVariant process settings accordingly to the number of threads
    deepvariant_threads = 96  // Number of parallel tasks for DeepVariant make_examples
    
    // Stop the run when a family has already been called but the pedigree lists members
    // that have no gVCF, instead of only warning. Off by default so a drifted cohort does
    // not become unrunnable without the operator choosing it.
    pedigree_strict = false

    // Delete the derived outputs of families whose pedigree has drifted, so they are re-called
    // in full, instead of only reporting them. Only families whose missing members can actually
    // be recovered - from data on disk and from the steps requested - are touched; the rest are
    // reported and left alone. Combine with --dry-run to see what it would remove.
    clean_stale_families = false

    // Ancestry and PGS configuration
    ancestry_reference = ""       // ancestry-pgs reference bundle directory
    ancestry_catalog = ""         // PGS weight catalog (SbayesRC layout TSV)
    ancestry_panel_name = ""      // label baked into output file names; bump it to invalidate
    ancestry_min_dp = 10          // minimum DP (variants) / MIN_DP (reference blocks) to call a panel site
    ancestry_min_gq = 20          // minimum GQ to call a panel site
    ancestry_min_coverage = ""    // override admixture's 0.90 per-sample coverage floor; empty = tool default
    ancestry_model = ""           // fitted z-score model dir; empty = the bundle's models/<catalog sha256>

    // ROH / inbreeding configuration. Reads the ancestry step's family panel and calls against
    // ancestry_reference, which must carry the roh/ tier; genes come from annotation_gencode.
    roh_min_gene_roh_mb = 1.0     // only ROH at least this long are intersected with genes
    
    // Container settings
    enable_conda = false
    singularity_pull_docker_container = false
    apptainer_cache = ""
    singularity_cache = ""
    
    // Resource defaults
    max_memory = '460.GB'
    max_cpus = 95
    max_time = '240.h'
}

workDir = params.work_dir ?: 'work'

// Process-specific configurations
process {
    // Default resources. Every cpus, memory and time below goes through sized(), so that a
    // cohort's params file can override it - see `resources` in documentation/params.md.
    cpus = sized('cpus', 1)
    memory = sized('memory', 4.GB)
    time = sized('time', 240.h)
    
    // Error handling
    errorStrategy = 'retry'
    maxRetries = 3

    container = 'fcliquet/bioinfo-swissknife:28611708ecf7c94ed97b9b7888c707550759b08a'

    // Priority labels for SLURM scheduling (nice values). Closures, so that every task is tagged
    // ghfc-ngs:<PROJECT>/<COHORT> once params are known - PROJECT being the last directory of
    // data, as run_pipeline.sh names it: `squeue -O Comment` then tells two live runs apart,
    // which the nf-<PROCESS> job names cannot, even for same-named cohorts of two projects.
    withLabel: fast {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=0 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    withLabel: normal {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=100 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    withLabel: slow {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=1000 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    // Process-specific settings
    withName: 'BWA_MEM2_ALIGN' {
        cpus = sized('cpus', 95)
        memory = sized('memory', 460.GB)
    }

    withName: 'BAZAM_BWA_MEM2_REALIGN' {
        cpus = sized('cpus', 47)
        memory = sized('memory', 320.GB, 70.GB)
    }
    
    withName: 'MERGE_UNITS' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 10.GB, 10.GB)
        container = 'docker://biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    
    withName: 'INDEX_CRAM' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 5.GB, 5.GB)
        container = 'docker://biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    
    // DeepVariant process settings requires version > 1.8
    withName: 'MAKE_EXAMPLES' {
        cpus = sized('cpus', 95)
        memory = sized('memory', 460.GB)
        container = 'docker://google/deepvariant:1.10.0-beta'
    }
    
    // DeepVariant process settings requires version > 1.8
    withName: 'CALL_VARIANTS' {
        cpus = sized('cpus', 95)
        memory = sized('memory', 460.GB)
        container = 'docker://google/deepvariant:1.9.0'
    }

    // DeepVariant process settings requires version > 1.8
    withName: 'POSTPROCESS_VARIANTS' {
        cpus = sized('cpus', 95)
        memory = sized('memory', 460.GB)
        container = 'docker://google/deepvariant:1.9.0'
    }

    withName: 'GLNEXUS_FAMILY' {
        container = 'docker://cgrlab/glnexus:v1.4.1'
        cpus = sized('cpus', 4)
        memory = sized('memory', 50.GB, 50.GB)
    }
    
    withName: 'NORMALIZE' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 2.GB, 2.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'FAMILIAL_PEDIGREE' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 1.GB, 1.GB)
    }
    
    withName: 'GNOMAD_FREQ_ANNOT' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 2.GB, 2.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'GNOMAD_FREQ_FILTER' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 2.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'COMMON_FILTERS' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 8.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'VEP_ANNOTATION' {
        cpus = sized('cpus', 18)
        memory = sized('memory', 10.GB, 10.GB)
        container = 'docker://ensemblorg/ensembl-vep:release_115.0'
    }
    
    withName: 'BCFTOOLS_ANNOTATE' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 2.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'DNM_EXTRACTION' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 1.GB, 1.GB)
        container = 'docker://brentp/slivar:latest'
    }
    
    withName: 'SNVS_COHORT_MERGE' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 150.GB, 150.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'MERGE_DNM' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'DNM_REPORT' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 8.GB, 8.GB)
    }
    
    withName: 'NPZ_CONVERT' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 28.GB, 28.GB)
        container = 'docker://fcliquet/wisecondorx:2.1.2'
    }
    
    withName: 'PREDICT' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 24.GB, 24.GB)
        container = 'docker://fcliquet/wisecondorx:2.1.2'
    }
    
    withName: 'REFORMAT_CHR' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 1.GB, 1.GB)
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'MERGE_FAMILY_ABERRATIONS' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 3.GB, 3.GB)
        container = 'docker://ubuntu:22.04'
    }

    withName: 'MERGE_COHORT_ABERRATIONS' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 6.GB, 6.GB)
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'ANNOTATE_ABERRATIONS' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 8.GB, 8.GB)
        container = 'docker://staphb/bedtools:latest'
    }
    
    withName: 'MOSDEPTH' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 5.GB, 5.GB)
        container = 'quay.io/biocontainers/mosdepth:0.3.11--h0ec343a_1'
    }
    
    withName: 'TABIX_INDEX' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 1.GB, 1.GB)
        container = 'docker://staphb/htslib:latest'
    }
    
    withName: 'BCF2PARQUET' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 8.GB, 8.GB)
    }

    withName: 'PYWOMBAT' {
        cpus = sized('cpus', 1)
        maxRetries = 8
        memory = sized('memory', 8.GB, 64.GB)
    }

    withName: 'PYWOMBAT_FILTER' {
        cpus = sized('cpus', 1)
        maxRetries = 8
        memory = sized('memory', 8.GB, 64.GB)
    }

    withName: 'VEP_MNV_ANNOTATION' {
        cpus = sized('cpus', 18)
        memory = sized('memory', 10.GB, 10.GB)
        container = 'docker://ensemblorg/ensembl-vep:release_115.0'
    }

    withName: 'WOMBAT_MERGE_ANNOTATIONS' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
    }
    
    withName: 'VCF2BEDGRAPH_VAF' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/vcf2bedgraph:latest'
    }
    
    // Migration processes
    withName: 'CONVERT_NORM_VCF_TO_BCF' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 8.GB, 8.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'CONVERT_COMMON_VCF_TO_BCF' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 8.GB, 8.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    withName: 'CLEANUP_LEGACY_FILES' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 2.GB, 2.GB)
        container = 'docker://staphb/bcftools:latest'
    }
    
    // Extractor processes
    withName: 'REFACTOR' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 8.GB, 8.GB)
    }
    
    withName: 'PROCESS_FAM_TSV' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 8.GB, 24.GB)
    }
    
    withName: 'PROCESS_FAM_BCF' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 8.GB, 16.GB)
    }
    
    withName: 'PROCESS_IND_GVCF' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
    }
    
    // Ancestry / PGS processes
    // The image is linux/amd64 only: upstream PLINK publishes no Linux arm64 build.
    withName: 'PANEL_SITES' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 2.GB, 2.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'PANEL_EXTRACT' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'PANEL_MERGE_FAMILY' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_PCS' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 8.GB, 8.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    // ANCESTRY_ADMIXTURE is the only ancestry step with a hard gate: it refuses a
    // sample below 90% per-sample coverage of the panel rather than returning
    // biased proportions. That is a per-sample data property, not a pipeline
    // fault, so one marginal sample must not abort a whole cohort - pcs and the
    // PGS chain succeed for the same family. 'ignore' leaves that family without
    // a Q table; the cohort merge's completeness barrier then skips the cohort Q
    // table with a warning rather than publishing a partial one, and every other
    // cohort table is unaffected. Grep the run for 'ANCESTRY_ADMIXTURE' to see
    // which families were skipped, or read min_per_sample_coverage from the
    // per-family admixture QC JSON.
    withName: 'ANCESTRY_ADMIXTURE' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 8.GB, 8.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
        errorStrategy = 'ignore'
    }
    
    // The heavy one: it aligns ~1.04M catalog sites and leaves ~100 MB of
    // intermediates in the task work directory
    withName: 'ANCESTRY_PGS_RAW' {
        cpus = sized('cpus', 8)
        memory = sized('memory', 16.GB, 16.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_PGS_APPLY' {
        cpus = sized('cpus', 2)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_COHORT_MERGE' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://ubuntu:22.04'
    }
    
    // ROH / inbreeding processes. Needs ancestry-pgs >= 0.2.0, the first with the roh command.
    // One bcftools roh per family member runs in parallel, so cpus beyond the family size idle.
    withName: 'ROH_CALL' {
        cpus = sized('cpus', 4)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.2.0'
    }

    withName: 'ROH_COHORT_MERGE' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
        container = 'docker://fcliquet/ancestry-pgs:v0.2.0'
    }

    withName: 'FAM_AGGREGATE' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
    }
    
    withName: 'AGGREGATE' {
        cpus = sized('cpus', 1)
        memory = sized('memory', 4.GB, 4.GB)
    }
}

// Executor configurations
executor {
    name = 'slurm'
    queueSize = 2500
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
}

// Container configurations
apptainer {
    autoMounts = true
    cacheDir = params.apptainer_cache ?: '/path/to/apptainer/cache'
    runOptions = '--bind /pasteur'
}

singularity {
    autoMounts = true
    cacheDir = params.singularity_cache ?: '/path/to/singularity/cache'
    runOptions = '--bind /pasteur'
}

docker {
    docker.runOptions = '-u $(id -u):$(id -g)'
}

// Environment profiles
profiles {
    
    // Local execution (for testing)
    local {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8.GB'
    }

    //SLURM execution
    slurm {
        process.executor = 'slurm'
        process.clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=100 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    // Apptainer
    apptainer {
        apptainer.enabled = true
        singularity.enabled = false
        docker.enabled = false
    }
    
    // Testing profile
    test {
        params {
            data = 'test_data/'
            scratch = 'test_scratch/'
            max_memory = '6.GB'
            max_cpus = 2
            max_time = '1.h'
        }
        
        process {
            cpus = { check_max( 1, 'cpus' ) }
            memory = { check_max( 2.GB * task.attempt, 'memory' ) }
            time = { check_max( 30.min * task.attempt, 'time' ) }
        }
    }
}

// Resource checking function
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// A process's cpus, memory or time, as a dynamic directive. `memory = sized('memory', 8.GB, 64.GB)`
// asks for 8 GB, then 64 GB more on each retry; cpus and time do not grow. `base` may also be a
// closure over the task's inputs, e.g. { 8.GB * barcodes.size() }, for a process whose needs
// follow its data. A byte count is taken as memory.
//
// The cohort's params file overrides any of it under `resources:`, by process, and within a
// process by family (fid) or sample (barcode), an exact id or a `*` glob. The precedence and the
// schema are in documentation/params.md; lib/ResourceOverrides.groovy checks the block when the
// run starts, because a mistake found here is found only when the first matching task is due.
// That class cannot be called from here: this file is compiled before lib/ is on the classpath.
def sized(String field, base, step = null) {
    return { -> resolveResource(task, delegate, field, base, step) }
}

def resolveResource(task, ctx, String field, base, step) {
    if (base instanceof Closure) {
        def inputs = (Closure) base.clone()
        inputs.delegate = ctx
        inputs.resolveStrategy = Closure.DELEGATE_FIRST
        base = inputs.call()
    }
    def value = base
    def increment = step

    // get(), not a property: on params, reading a missing key would create it, empty
    def all = params.get('resources')
    // task.process is the alias for an included `X as Y`, and qualified by its workflow
    def name = task.process.tokenize(':')[-1]
    def entry = null
    if (all instanceof Map) {
        entry = all.find { k, v -> k.toString() == name }?.value
        if (entry == null) entry = all.find { k, v -> name ==~ k.toString() }?.value
    }
    def layers = entry instanceof Map ? [entry] : []
    def id_key = ctx.containsKey('fid') ? 'fid' : ctx.containsKey('barcode') ? 'barcode' : null
    def section = (entry instanceof Map && id_key) ? entry.get(id_key == 'fid' ? 'families' : 'samples') : null
    if (section instanceof Map) {
        // Ids compared as strings: YAML reads an all-digit fid as a number
        def id = ctx.get(id_key).toString()
        def glob = section.find { k, v ->
            def pattern = k.toString()
            pattern.contains('*') && id ==~ pattern.split(/\*/, -1).collect { java.util.regex.Pattern.quote(it) }.join('.*')
        }
        if (glob) layers << glob.value
        def exact = section.find { k, v -> k.toString() == id }
        if (exact) layers << exact.value
    }
    layers.each { layer ->
        if (!(layer instanceof Map)) return
        if (layer.get(field) != null) value = layer.get(field)
        if (field == 'memory' && layer.get('memory_step') != null) increment = layer.get('memory_step')
    }

    def toMemory = { v ->
        if (v == null) return new nextflow.util.MemoryUnit(0)
        if (v instanceof nextflow.util.MemoryUnit) return v
        if (v instanceof Number) return new nextflow.util.MemoryUnit(v as long)
        return new nextflow.util.MemoryUnit(v.toString())
    }
    switch (field) {
        case 'memory':
            return check_max(toMemory(value) + toMemory(increment) * (task.attempt - 1), 'memory')
        case 'cpus':
            return check_max(value as int, 'cpus')
        case 'time':
            def duration = value instanceof nextflow.util.Duration ? value : new nextflow.util.Duration(value.toString())
            return check_max(duration, 'time')
    }
    throw new IllegalArgumentException("sized(): unknown field '${field}'")
}

// Manifest
manifest {
    name = 'ghfc-ngs'
    contributors = [
        [
            name: 'F. Cliquet',
            affiliation: 'Institut Pasteur',
            email: 'fcliquet@pasteur.fr',
            orcid: '0000-0002-9989-0685',
            github: 'https://github.com/fcliquet'
        ]
    ]
    homePage = 'https://github.com/bourgeron-lab/ghfc-ngs'
    docsUrl = 'https://github.com/bourgeron-lab/ghfc-ngs/blob/main/HOWTO.md'
    description = 'WGS pipeline for GHFC project'
    defaultBranch = 'main'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.3'
    license = 'MIT'
    version = '1.0.0'
}

// Timeline and reports
timeline {
    enabled = true
    overwrite = true
    file = "reports/timeline_${new Date().format('yyyyMMdd-HHmmss')}.html"
}

report {
    enabled = true
    overwrite = true
    file = "reports/report_${new Date().format('yyyyMMdd-HHmmss')}.html"
}

trace {
    enabled = true
    overwrite = true
    file = "reports/trace_${new Date().format('yyyyMMdd-HHmmss')}.txt"
    // The default fields plus what was asked for, so scripts/resources_report can set the two
    // side by side
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,time,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    overwrite = true
    file = "reports/dag_${new Date().format('yyyyMMdd-HHmmss')}.svg"
}

nextflow {
    enable {
        configProcessNamesValidation = false
    }
}
