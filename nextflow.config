// Nextflow configuration file for GHFC WGS Alignment Pipeline

params {
    // Pipeline steps control
    steps = ['alignment']  
    skip_alignment = false
    skip_deepvariant = false
    
    // Input/Output paths
    data = ""
    scratch = ""
    
    // Reference genomes
    ref = ""
    ref_name = ""
    old_ref_38 = ""
    old_cram_38 = ""
    old_ref_37 = ""
    old_cram_37 = ""
    
    // File patterns
    fastq_pattern = ""
    cram4realignment_pattern = "*.cram"
    
    // Bedgraph parameters
    bin = 1000  // Bin size for bedgraph generation
    
    // Tool paths (can be overridden when using containers)
    bwa_mem2 = "bwa-mem2"
    samblaster = "samblaster"
    sambamba = "sambamba"
    samtools = "samtools"
    bazam = "/path/to/bazam.jar"
    
    // GLnexus configuration
    glnexus_config = "DeepVariant_unfiltered"
    // Optional BED of ranges to joint-call, for exome cohorts: a DeepVariant gVCF covers the
    // whole genome with reference blocks, so without it every off-target call reaches annotation.
    // Must be sorted and merged - GLnexus rejects overlapping ranges. Empty calls the whole genome.
    glnexus_bed = ""

    // Whether a sample's VAF bedgraph is part of its deepvariant_sample outputs. Turn it off for
    // a cohort that arrives as gVCFs only: the bedgraph is built from the CRAM-derived VCF, so it
    // can never exist, and requiring it would send every sample back to alignment.
    vaf_bedgraph = true

    // DeepVariant configuration
    // WARNING: Update DeepVariant process settings accordingly to the number of threads
    deepvariant_threads = 96  // Number of parallel tasks for DeepVariant make_examples
    
    // Stop the run when a family has already been called but the pedigree lists members
    // that have no gVCF, instead of only warning. Off by default so a drifted cohort does
    // not become unrunnable without the operator choosing it.
    pedigree_strict = false

    // Delete the derived outputs of families whose pedigree has drifted, so they are re-called
    // in full, instead of only reporting them. Only families whose missing members can actually
    // be recovered - from data on disk and from the steps requested - are touched; the rest are
    // reported and left alone. Combine with --dry-run to see what it would remove.
    clean_stale_families = false

    // Ancestry and PGS configuration
    ancestry_reference = ""       // ancestry-pgs reference bundle directory
    ancestry_catalog = ""         // PGS weight catalog (SbayesRC layout TSV)
    ancestry_panel_name = ""      // label baked into output file names; bump it to invalidate
    ancestry_min_dp = 10          // minimum DP (variants) / MIN_DP (reference blocks) to call a panel site
    ancestry_min_gq = 20          // minimum GQ to call a panel site
    ancestry_min_coverage = ""    // override admixture's 0.90 per-sample coverage floor; empty = tool default
    ancestry_model = ""           // fitted z-score model dir; empty = the bundle's models/<catalog sha256>

    // ROH / inbreeding configuration. Reads the ancestry step's family panel and calls against
    // ancestry_reference, which must carry the roh/ tier; genes come from annotation_gencode.
    roh_min_gene_roh_mb = 1.0     // only ROH at least this long are intersected with genes

    // ExpansionHunter configuration. Genotypes the catalog's repeats from the CRAMs, with the
    // alignment reference (ref); the sex given to it comes from the pedigree.
    expansionhunter_catalog = ""       // variant catalog JSON
    expansionhunter_catalog_name = ""  // label baked into output file names; one per catalog
    expansionhunter_thresholds = ""    // per-locus thresholds TSV; empty leaves alleles unclassified
    expansionhunter_reviewer = true    // REViewer pileups of the flagged genotypes; needs the thresholds

    // MELT configuration. Calls mobile element insertions from the CRAMs with the alignment
    // reference (ref); MELT is not in any image (licence), it runs from melt_dir. The cohort
    // scoring also reads the annotation's gencode gene BED (annotation_gencode).
    melt_dir = ""                      // MELT v2.2.2 distribution: MELT.jar, me_refs/, add_bed_files/
    melt_label = ""                    // label baked into output file names; one per way of calling
    melt_gnomad_sv = ""                // gnomAD-SV sites VCF, for the population frequency of insertions
    melt_ndd_genes = ""                // NDD gene table, with a Symbol column
    melt_ndd_columns = "High Confidence NDD genes v3"  // '|'-separated columns of it marking a gene NDD

    // CNV coverage configuration. Normalised per-sample coverage bigWigs for genetics-viz, a
    // control panel built from a controls cohort, and the fit of a cohort against such a panel.
    // cnv_cov_bin and cnv_cov_mapq make the tag cov_b<bin>q<mapq> in every file name.
    cnv_cov_bin = 250                  // bin size in bp; every sample and panel share its grid
    cnv_cov_mapq = 1                   // minimum mapping quality of the reads counted
    cnv_cov_round = 0.01               // precision the normalised values are stored at; not in the tag
    cnv_panel_dir = ""                 // a panel version directory to fit the cohort against; empty = no fit
    cnv_panel_version = ""             // the version cnv_panel builds, as cnv_panel/v<version>; required by it
    cnv_panel_max_fit_mad = 0.3        // controls whose fit MAD is above this are left out of the panel

    // Sample QC configuration. Relatedness against the pedigree, within and between families,
    // and sex and karyotype, from somalier's counts at its sites in each CRAM; the sex also
    // reads the cnv_coverage JSONs, with the cnv_cov_bin and cnv_cov_mapq above, when there are.
    somalier_sites = ""                // somalier's sites VCF for the reference, e.g. sites.hg38.vcf.gz
    sampleqc_label = ""                // label baked into output file names; one per sites file
    sampleqc_hom_cutoff = 0.1          // somalier relate calls a site homozygous below this allele fraction, or above 1 minus it
    
    // Container settings
    enable_conda = false
    singularity_pull_docker_container = false
    apptainer_cache = ""
    singularity_cache = ""
    
    // Resource defaults
    max_memory = '460.GB'
    max_cpus = 95
    max_time = '240.h'
}

workDir = params.work_dir ?: 'work'

// Process-specific configurations
process {
    // Resources. A process's defaults are in its `ext`: cpus, memory, memory_step (added on each
    // retry) and time, here and in the withName blocks below. The directives themselves are set
    // once, for every process, from ext.sized (at the end of this file), so that a cohort's
    // params file can override any of them - see `resources` in documentation/params.md.
    ext.cpus = 1
    ext.memory = 4.GB
    ext.time = 240.h
    cpus = { task.ext.sized.cpus }
    memory = { task.ext.sized.memory }
    time = { task.ext.sized.time }

    // The ceilings: a task asking for more is clamped down to them, not failed
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 3

    container = 'fcliquet/bioinfo-swissknife:28611708ecf7c94ed97b9b7888c707550759b08a'

    // Priority labels for SLURM scheduling (nice values). Closures, so that every task is tagged
    // ghfc-ngs:<PROJECT>/<COHORT> once params are known - PROJECT being the last directory of
    // data, as run_pipeline.sh names it: `squeue -O Comment` then tells two live runs apart,
    // which the nf-<PROCESS> job names cannot, even for same-named cohorts of two projects.
    withLabel: fast {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=0 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    withLabel: normal {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=100 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    withLabel: slow {
        clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=1000 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    // Process-specific settings
    withName: 'BWA_MEM2_ALIGN' {
        ext = [cpus: 95, memory: 460.GB]
    }

    withName: 'BAZAM_BWA_MEM2_REALIGN' {
        ext = [cpus: 47, memory: 320.GB, memory_step: 70.GB]
    }
    
    withName: 'MERGE_UNITS' {
        ext = [cpus: 1, memory: 10.GB, memory_step: 10.GB]
        container = 'docker://biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    
    withName: 'INDEX_CRAM' {
        ext = [cpus: 1, memory: 5.GB, memory_step: 5.GB]
        container = 'docker://biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    
    // DeepVariant process settings requires version > 1.8
    withName: 'MAKE_EXAMPLES' {
        ext = [cpus: 95, memory: 460.GB]
        container = 'docker://google/deepvariant:1.10.0-beta'
    }
    
    // DeepVariant process settings requires version > 1.8
    withName: 'CALL_VARIANTS' {
        ext = [cpus: 95, memory: 460.GB]
        container = 'docker://google/deepvariant:1.9.0'
    }

    // DeepVariant process settings requires version > 1.8
    withName: 'POSTPROCESS_VARIANTS' {
        ext = [cpus: 95, memory: 460.GB]
        container = 'docker://google/deepvariant:1.9.0'
    }

    withName: 'GLNEXUS_FAMILY' {
        container = 'docker://cgrlab/glnexus:v1.4.1'
        ext = [cpus: 4, memory: 50.GB, memory_step: 50.GB]
    }
    
    withName: 'NORMALIZE' {
        ext = [cpus: 2, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'FAMILIAL_PEDIGREE' {
        ext = [cpus: 1, memory: 1.GB, memory_step: 1.GB]
    }
    
    withName: 'GNOMAD_FREQ_ANNOT' {
        ext = [cpus: 2, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'GNOMAD_FREQ_FILTER' {
        ext = [cpus: 2, memory: 2.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'COMMON_FILTERS' {
        ext = [cpus: 4, memory: 8.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'VEP_ANNOTATION' {
        ext = [cpus: 18, memory: 10.GB, memory_step: 10.GB]
        container = 'docker://ensemblorg/ensembl-vep:release_115.0'
    }
    
    withName: 'BCFTOOLS_ANNOTATE' {
        ext = [cpus: 2, memory: 2.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'SNVS_COHORT_MERGE' {
        ext = [cpus: 4, memory: 150.GB, memory_step: 150.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'MERGE_DNM' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'NPZ_CONVERT' {
        ext = [cpus: 1, memory: 28.GB, memory_step: 28.GB]
        container = 'docker://fcliquet/wisecondorx:2.1.2'
    }
    
    withName: 'PREDICT' {
        ext = [cpus: 1, memory: 24.GB, memory_step: 24.GB]
        container = 'docker://fcliquet/wisecondorx:2.1.2'
    }
    
    withName: 'REFORMAT_CHR' {
        ext = [cpus: 1, memory: 1.GB, memory_step: 1.GB]
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'MERGE_FAMILY_ABERRATIONS' {
        ext = [cpus: 1, memory: 3.GB, memory_step: 3.GB]
        container = 'docker://ubuntu:22.04'
    }

    withName: 'MERGE_COHORT_ABERRATIONS' {
        ext = [cpus: 1, memory: 6.GB, memory_step: 6.GB]
        container = 'docker://ubuntu:22.04'
    }
    
    withName: 'ANNOTATE_ABERRATIONS' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://staphb/bedtools:2.31.1'
    }
    
    withName: 'MOSDEPTH' {
        ext = [cpus: 4, memory: 5.GB, memory_step: 5.GB]
        container = 'quay.io/biocontainers/mosdepth:0.3.11--h0ec343a_1'
    }
    
    withName: 'TABIX_INDEX' {
        ext = [cpus: 1, memory: 1.GB, memory_step: 1.GB]
        container = 'docker://staphb/htslib:1.24'
    }
    
    withName: 'BCF2PARQUET' {
        ext = [cpus: 2, memory: 8.GB, memory_step: 8.GB]
    }

    withName: 'PYWOMBAT' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 64.GB]
        maxRetries = 8
    }

    withName: 'PYWOMBAT_FILTER' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 64.GB]
        maxRetries = 8
    }

    withName: 'VEP_MNV_ANNOTATION' {
        ext = [cpus: 18, memory: 10.GB, memory_step: 10.GB]
        container = 'docker://ensemblorg/ensembl-vep:release_115.0'
    }

    withName: 'WOMBAT_MERGE_ANNOTATIONS' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
    }
    
    withName: 'VCF2BEDGRAPH_VAF' {
        ext = [cpus: 2, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/vcf2bedgraph:0.1.5'
    }
    
    // Migration processes
    withName: 'CONVERT_NORM_VCF_TO_BCF' {
        ext = [cpus: 2, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'CONVERT_COMMON_VCF_TO_BCF' {
        ext = [cpus: 2, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    withName: 'CLEANUP_LEGACY_FILES' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://staphb/bcftools:1.24'
    }
    
    // Extractor processes
    withName: 'REFACTOR' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 8.GB]
    }
    
    withName: 'PROCESS_FAM_TSV' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 24.GB]
    }
    
    withName: 'PROCESS_FAM_BCF' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 16.GB]
    }
    
    withName: 'PROCESS_IND_GVCF' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
    }
    
    // Ancestry / PGS processes
    // The image is linux/amd64 only: upstream PLINK publishes no Linux arm64 build.
    withName: 'PANEL_SITES' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'PANEL_EXTRACT' {
        ext = [cpus: 2, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'PANEL_MERGE_FAMILY' {
        ext = [cpus: 2, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_PCS' {
        ext = [cpus: 4, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    // ANCESTRY_ADMIXTURE is the only ancestry step with a hard gate: it refuses a
    // sample below 90% per-sample coverage of the panel rather than returning
    // biased proportions. That is a per-sample data property, not a pipeline
    // fault, so one marginal sample must not abort a whole cohort - pcs and the
    // PGS chain succeed for the same family. 'ignore' leaves that family without
    // a Q table; the cohort merge's completeness barrier then skips the cohort Q
    // table with a warning rather than publishing a partial one, and every other
    // cohort table is unaffected. Grep the run for 'ANCESTRY_ADMIXTURE' to see
    // which families were skipped, or read min_per_sample_coverage from the
    // per-family admixture QC JSON.
    withName: 'ANCESTRY_ADMIXTURE' {
        ext = [cpus: 4, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
        errorStrategy = 'ignore'
    }
    
    // The heavy one: it aligns ~1.04M catalog sites and leaves ~100 MB of
    // intermediates in the task work directory
    withName: 'ANCESTRY_PGS_RAW' {
        ext = [cpus: 8, memory: 16.GB, memory_step: 16.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_PGS_APPLY' {
        ext = [cpus: 2, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.1.1'
    }
    
    withName: 'ANCESTRY_COHORT_MERGE' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://ubuntu:22.04'
    }
    
    // ROH / inbreeding processes. Needs ancestry-pgs >= 0.2.0, the first with the roh command.
    // One bcftools roh per family member runs in parallel, so cpus beyond the family size idle.
    withName: 'ROH_CALL' {
        ext = [cpus: 4, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.2.0'
    }

    withName: 'ROH_COHORT_MERGE' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/ancestry-pgs:v0.2.0'
    }

    // ExpansionHunter processes. The image's ExpansionHunter 5.0.0 is the bioconda build linked
    // against htslib 1.22, which reads CRAM 3.1; see containers/expansionhunter/Dockerfile.
    // A call takes about 4 minutes and well under 1 GB; the threads gain little beyond 4.
    withName: 'EXPANSIONHUNTER_CALL' {
        ext = [cpus: 4, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/expansionhunter:5.0.0'
    }

    withName: 'EXPANSIONHUNTER_FAMILY' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://fcliquet/expansionhunter:5.0.0'
    }

    withName: 'EXPANSIONHUNTER_COHORT' {
        ext = [cpus: 2, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://fcliquet/expansionhunter:5.0.0'
    }

    // REViewer is the bioconda build, used as biocontainers publishes it: its licence (PolyForm
    // Strict) forbids redistributing it, so it is in no image of ours. One task per family,
    // about a second per flagged locus.
    withName: 'EXPANSIONHUNTER_REVIEWER' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://quay.io/biocontainers/reviewer:0.2.7--h48da230_0'
    }

    // MELT processes. MELT is not in the image - its licence forbids redistributing it - and runs
    // from params.melt_dir; see containers/melt/Dockerfile. A call takes about 5 hours at 30-40x
    // and under 6 GB of heap, but a CRAM above ~50x exhausts it in MELT's pinpoint step: Java then
    // exits with status 3 (-XX:+ExitOnOutOfMemoryError) and the call is retried with 64 GB, then
    // 120 GB, the heap following the memory. Any other failure - status 64 is a CRAM aligned to
    // another reference - is not retried but ignored, as for ANCESTRY_ADMIXTURE, so that one bad
    // CRAM does not stop a cohort's run: its family merge and the cohort scoring are then skipped
    // with a warning. MELT's ~20 GB of intermediates go to node-local scratch.
    withName: 'MELT_CALL' {
        ext = [cpus: 2, memory: 8.GB, memory_step: 56.GB, time: 72.h]
        container = 'docker://fcliquet/melt-deps:1.0.0'
        scratch = true
        errorStrategy = { task.exitStatus in [3, 137, 140] && task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
    }

    withName: 'MELT_FAMILY' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://fcliquet/melt-deps:1.0.0'
    }

    // Every sample's calls in one task: ~4M PASS insertions for 4,000 samples
    withName: 'MELT_COHORT' {
        ext = [cpus: 1, memory: 16.GB, memory_step: 16.GB]
        container = 'docker://fcliquet/melt-deps:1.0.0'
    }

    // CNV coverage processes. A sample is a mosdepth pass over its CRAM - --fast-mode skips the
    // CRAM's sequences and qualities, so a 34x CRAM 3.1 takes about 80 s - then 12.4 M bins at
    // 250 bp in a few numpy arrays, about 10 s and a 2 GB peak, and a 33 MB bigWig. The fit and
    // the panel read every sample's bigWig in parallel, one contig at a time: the panel holds a
    // contig of every control at once, ~2 GB for chr1 at 500 controls, and partitions it. On 20
    // controls it took 25 s on 4 threads and 0.6 GB.
    withName: 'CNV_COVERAGE_SAMPLE' {
        ext = [cpus: 4, memory: 4.GB, memory_step: 4.GB]
        container = 'docker://fcliquet/cnv-coverage:1.0.0'
    }

    withName: 'CNV_COVERAGE_FIT' {
        ext = [cpus: 8, memory: 16.GB, memory_step: 16.GB]
        container = 'docker://fcliquet/cnv-coverage:1.0.0'
    }

    withName: 'CNV_PANEL_BUILD' {
        ext = [cpus: 16, memory: 32.GB, memory_step: 32.GB, time: 24.h]
        container = 'docker://fcliquet/cnv-coverage:1.0.0'
    }

    // Sample QC processes. An extract reads ~17,800 sites of a CRAM, a few minutes at 30x; a
    // family's relate is instant and its Mendelian counts stream its norm.bcf through python,
    // about a minute for a trio. The cohort's relate compares every pair, about a minute for
    // 4,500 samples, in memory linear in the samples.
    withName: 'SOMALIER_EXTRACT' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://fcliquet/sampleqc:1.0.0'
    }

    withName: 'SAMPLEQC_FAMILY' {
        ext = [cpus: 1, memory: 2.GB, memory_step: 2.GB]
        container = 'docker://fcliquet/sampleqc:1.0.0'
    }

    withName: 'SAMPLEQC_COHORT' {
        ext = [cpus: 1, memory: 8.GB, memory_step: 8.GB]
        container = 'docker://fcliquet/sampleqc:1.0.0'
    }

    withName: 'FAM_AGGREGATE' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
    }
    
    withName: 'AGGREGATE' {
        ext = [cpus: 1, memory: 4.GB, memory_step: 4.GB]
    }
}

// Executor configurations
executor {
    name = 'slurm'
    queueSize = 2500
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
}

// Container configurations
apptainer {
    autoMounts = true
    cacheDir = params.apptainer_cache ?: '/path/to/apptainer/cache'
    runOptions = '--bind /pasteur'
}

singularity {
    autoMounts = true
    cacheDir = params.singularity_cache ?: '/path/to/singularity/cache'
    runOptions = '--bind /pasteur'
}

docker {
    docker.runOptions = '-u $(id -u):$(id -g)'
}

// Environment profiles
profiles {
    
    // Local execution (for testing)
    local {
        process.executor = 'local'
        process.ext.cpus = 4
        process.ext.memory = 8.GB
    }

    //SLURM execution
    slurm {
        process.executor = 'slurm'
        process.clusterOptions = { "-p ghfc --qos=ghfc --exclude=maestro-1096,maestro-1082,maestro-1098,maestro-1090 --nice=100 --comment=ghfc-ngs:${params.data ? params.data.toString().replaceAll('/+$', '').tokenize('/')[-1].replaceAll('[^A-Za-z0-9_-]', '_') + '/' : ''}${params.cohort_name}" }
    }

    // Apptainer
    apptainer {
        apptainer.enabled = true
        singularity.enabled = false
        docker.enabled = false
    }
    
    // Testing profile
    test {
        params {
            data = 'test_data/'
            scratch = 'test_scratch/'
            max_memory = '6.GB'
            max_cpus = 2
            max_time = '1.h'
        }
        
        process {
            // Set again: the one above was set before this profile's params
            resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
            ext.cpus = 1
            ext.memory = 2.GB
            ext.memory_step = 2.GB
            ext.time = { 30.min * task.attempt }
        }
    }
}

// A task's cpus, memory and time, which the directives at the top of the process scope read. The
// process's defaults are in its ext: `ext = [memory: 8.GB, memory_step: 64.GB]` asks for 8 GB,
// then 64 GB more on each retry; cpus and time do not grow. A default may also be a closure over
// the task's inputs, e.g. `memory: { 8.GB * barcodes.size() }`, for a process whose needs follow
// its data. A byte count is taken as memory. The ceilings are applied after, by resourceLimits.
//
// The cohort's params file overrides any of it under `resources:`, by process, and within a
// process by family (fid) or sample (barcode), an exact id or a `*` glob. The precedence and the
// schema are in documentation/params.md; lib/ResourceOverrides.groovy checks the block when the
// run starts, because a mistake found here is found only when the first matching task is due.
// That class cannot be called from here: this file is compiled before lib/ is on the classpath.
// Nor can a function be defined here, which the strict config syntax refuses: hence a closure in
// ext, which Nextflow evaluates for each task with the task's inputs in scope.
process.ext.sized = { ->
    def settings = [cpus: task.ext.cpus, memory: task.ext.memory, memory_step: task.ext.memory_step, time: task.ext.time]

    // containsKey first: on params, reading a missing key, even with get(), warns or creates it
    def all = params.containsKey('resources') ? params.get('resources') : null
    // task.process is the alias for an included `X as Y`, and qualified by its workflow
    def name = task.process.tokenize(':')[-1]
    def entry = null
    if (all instanceof Map) {
        entry = all.find { k, _v -> k.toString() == name }?.value
        if (entry == null) entry = all.find { k, _v -> name ==~ k.toString() }?.value
    }
    def layers = entry instanceof Map ? [entry] : []
    def id_key = delegate.containsKey('fid') ? 'fid' : delegate.containsKey('barcode') ? 'barcode' : null
    def section = (entry instanceof Map && id_key) ? entry.get(id_key == 'fid' ? 'families' : 'samples') : null
    if (section instanceof Map) {
        // Ids compared as strings: YAML reads an all-digit fid as a number
        def id = delegate.get(id_key).toString()
        def glob = section.find { k, _v ->
            def pattern = k.toString()
            pattern.contains('*') && id ==~ pattern.split(/\*/, -1).collect { part -> java.util.regex.Pattern.quote(part) }.join('.*')
        }
        if (glob) layers << glob.value
        def exact = section.find { k, _v -> k.toString() == id }
        if (exact) layers << exact.value
    }
    layers.each { layer ->
        if (!(layer instanceof Map)) return
        settings.keySet().each { field -> if (layer.get(field) != null) settings[field] = layer.get(field) }
    }

    def toMemory = { v ->
        if (v == null) return new nextflow.util.MemoryUnit(0)
        if (v instanceof nextflow.util.MemoryUnit) return v
        if (v instanceof Number) return new nextflow.util.MemoryUnit(v as long)
        return new nextflow.util.MemoryUnit(v.toString())
    }
    return [
        cpus: settings.cpus as int,
        memory: toMemory.call(settings.memory) + toMemory.call(settings.memory_step) * (task.attempt - 1),
        time: settings.time instanceof nextflow.util.Duration ? settings.time : new nextflow.util.Duration(settings.time.toString())
    ]
}

// Manifest
manifest {
    name = 'ghfc-ngs'
    contributors = [
        [
            name: 'F. Cliquet',
            affiliation: 'Institut Pasteur',
            email: 'fcliquet@pasteur.fr',
            orcid: '0000-0002-9989-0685',
            github: 'https://github.com/fcliquet'
        ]
    ]
    homePage = 'https://github.com/bourgeron-lab/ghfc-ngs'
    docsUrl = 'https://github.com/bourgeron-lab/ghfc-ngs/blob/main/HOWTO.md'
    description = 'WGS pipeline for GHFC project'
    defaultBranch = 'main'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.3'
    license = 'MIT'
    version = '1.0.0'
}

// Timeline and reports
timeline {
    enabled = true
    overwrite = true
    file = "reports/timeline_${new Date().format('yyyyMMdd-HHmmss')}.html"
}

report {
    enabled = true
    overwrite = true
    file = "reports/report_${new Date().format('yyyyMMdd-HHmmss')}.html"
}

trace {
    enabled = true
    overwrite = true
    file = "reports/trace_${new Date().format('yyyyMMdd-HHmmss')}.txt"
    // The default fields plus what was asked for, so scripts/resources_report can set the two
    // side by side
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,time,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    overwrite = true
    file = "reports/dag_${new Date().format('yyyyMMdd-HHmmss')}.svg"
}

nextflow {
    enable {
        configProcessNamesValidation = false
    }
}
