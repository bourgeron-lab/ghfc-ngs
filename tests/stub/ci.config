// Layered over nextflow.config for the CI stub runs (-c tests/stub/ci.config): every task runs
// locally and at once, and a failed task is recorded rather than stopping the run, so one run
// reports every broken stub. The params file caps resources to what a CI runner has.

executor {
    name = 'local'
    pollInterval = '1 sec'
}

process {
    executor = 'local'
    maxRetries = 0
    errorStrategy = 'ignore'
}

// The run's trace is given on the command line; nothing else is worth writing
timeline.enabled = false
report.enabled = false
dag.enabled = false
