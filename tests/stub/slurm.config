// Layered over nextflow.config and its slurm profile for the cluster-options check of
// tests/stub/run.sh (-profile slurm -c tests/stub/slurm.config), with a fake sbatch on PATH that
// records the #SBATCH lines of what it is given and refuses it: the first submission ends the run.

process {
    maxRetries = 0
    errorStrategy = 'terminate'
}

timeline.enabled = false
report.enabled = false
dag.enabled = false
