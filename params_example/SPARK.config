// Optional resource overrides for SPARK, given with: run_pipeline.sh SPARK --config params_example/SPARK.config
//
// The defaults in nextflow.config are sized for a WGS family. An exome family's rare variants
// are a few thousand records, so these jobs need a fraction of that - and at roughly a dozen
// jobs per family, tens of thousands of families is hundreds of thousands of SLURM jobs, where
// every core asked for and not used is queue time for the whole cohort.
process {
    withName: 'GLNEXUS_FAMILY' {
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEP_ANNOTATION' {
        cpus = 4
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEP_MNV_ANNOTATION' {
        cpus = 4
        memory = { 8.GB * task.attempt }
    }
}
